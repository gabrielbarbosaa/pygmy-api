# Gere cada segredo com:  openssl rand -hex 32
OTP_SECRET=
REDIS_PASSWORD=

# Chave da demo do site (cliente embutido)
PYGMY_WEB_KEY=
# Autoriza o painel a gerenciar credenciais (>= 32 chars). Nunca compartilhe.
PYGMY_ADMIN_KEY=

# ── Login do /admin ──────────────────────────────────────────────────────────
# GitHub (recomendado): github.com/settings/developers → OAuth Apps → New OAuth App
#   Homepage URL:  <APP_URL>
#   Callback URL:  <APP_URL>/api/admin/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Usernames do GitHub autorizados (separe por vírgula). Vazio = GitHub desativado.
ADMIN_GITHUB_USERS=
# URL pública do site (local: http://localhost:3100). Usada no callback do OAuth.
APP_URL=http://localhost:3100

# URL pública da API (aparece nos exemplos de código do site)
PUBLIC_API_URL=https://api.seudominio.com

# Portas no host (somente 127.0.0.1). Escolha portas livres na VPS.
WEB_PORT=3100
API_PORT=8100

# "smtp" para enviar e-mail de verdade; "console" só loga o código (apenas dev)
OTP_SENDER=smtp

# Hostinger (hPanel → E-mails → crie a caixa, ex.: no-reply@seudominio.com)
SMTP_HOST=smtp.hostinger.com
# 465 = SSL implícito. Alternativa: SMTP_PORT=587 com SMTP_USE_SSL=false (STARTTLS)
SMTP_PORT=465
SMTP_USE_SSL=true
# Endereço COMPLETO da caixa
SMTP_USER=no-reply@seudominio.com
SMTP_PASSWORD=
# Opcional. Precisa ser o mesmo domínio/caixa de SMTP_USER. Vazio = usa SMTP_USER.
# Aceita nome de exibição:  pygmy <no-reply@seudominio.com>
SMTP_FROM=
APP_NAME=pygmy

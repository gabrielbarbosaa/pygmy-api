# Modelo de produção (VPS) — copie para .env na VPS e preencha.
# Gere os segredos com:  openssl rand -hex 32   (REDIS_PASSWORD pode ser -hex 16)
OTP_SECRET=
REDIS_PASSWORD=
PYGMY_WEB_KEY=
PYGMY_ADMIN_KEY=

# Domínio público
APP_URL=https://pygmy.gabrielbarbosadev.com.br
PUBLIC_API_URL=https://pygmy.gabrielbarbosadev.com.br

# Login do /admin (GitHub OAuth App de PRODUÇÃO — callback:
#   https://pygmy.gabrielbarbosadev.com.br/api/admin/github/callback )
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ADMIN_GITHUB_USERS=gabrielbarbosaa

# Portas locais (127.0.0.1). Troque se já estiverem em uso na VPS.
WEB_PORT=3100
API_PORT=8100

# E-mail (Hostinger)
OTP_SENDER=smtp
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
APP_NAME=pygmy
